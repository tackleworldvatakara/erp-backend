PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/erp_db?retryWrites=true&w=majority

# JWT — generate two different random strings (min 32 chars each)
JWT_SECRET=your_jwt_secret_here_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173,https://erp-frontend-lime-xi.vercel.app
# Optional for local development; leave unset in production.
# COOKIE_DOMAIN=localhost
